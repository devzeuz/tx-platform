# ==============================================================================
# Control Plane Environment Settings
# Copy this file to `.env` inside control_plane/ (or project root) and fill in
# your real values when you are ready to trigger live GitHub Actions runs.
# ==============================================================================

# Your GitHub Personal Access Token (needs `repo` and `workflow` permissions)
GITHUB_TOKEN=ghp_your_token_here

# The GitHub repository hosting .github/workflows/deploy-s3-golden-path.yml
# Format: owner/repo-name
GITHUB_REPO=your-username/tx-platform

# Branch containing the workflow file (usually main)
GITHUB_BRANCH=main

